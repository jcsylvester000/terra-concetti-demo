# Copy to .env.local for local development. Set real values in Netlify (Site configuration > Environment variables).
# Canonical base URL. On Netlify it falls back to the deploy URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" on the real production domain. Anything else = every page noindex + robots.txt disallow.
ALLOW_INDEXING=false
# Google Tag Manager container (GTM-XXXXXXX). Empty = no tracking scripts and no consent banner.
NEXT_PUBLIC_GTM_ID=
